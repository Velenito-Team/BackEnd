{
    # Nginx already owns host port 80 on this server.
    auto_https disable_redirects
    # IP clients usually omit SNI; Docker sees an internal destination IP.
    default_sni {$COMPROBANTES_DOMAIN}
    log default {
        format filter {
            wrap json
            fields {
                request>uri delete
            }
        }
    }
}

{$COMPROBANTES_DOMAIN} {
    # Explicit public issuer: the default IP policy would use a local CA.
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
            disable_http_challenge
        }
    }

    header {
        Cache-Control "no-store"
        X-Robots-Tag "noindex, nofollow"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
    @receipt {
        method GET
        path_regexp receipt ^/api/invoices/receipt/[a-f0-9]{64}$
    }
    handle @receipt {
        reverse_proxy backend:8080
    }
    handle {
        header Content-Type "application/json; charset=utf-8"
        respond `{"message":"Comprobante no disponible."}` 404
    }
    handle_errors {
        header Content-Type "application/json; charset=utf-8"
        respond `{"message":"Comprobante no disponible."}` {err.status_code}
    }
}
