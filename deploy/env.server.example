# Copia la conexión y los valores vigentes de tu configuración local.
# No generes otro secreto: conservarlo permite seguir usando los tokens existentes.
MONGODB_URI=mongodb://USUARIO:CLAVE@HOST:27017/tienda-velenito?authSource=tienda-velenito&replicaSet=rs0&directConnection=true
VELENITO_POS_USER=OPERADOR_EXISTENTE
VELENITO_RECEIPT_SECRET=SECRETO_ACTUAL_DE_AL_MENOS_32_BYTES
COMPROBANTES_DOMAIN=comprobantes.tudominio.com
# Si solo tienes una IP pública, úsala arriba sin http(s) y activa:
# CADDYFILE=Caddyfile.ip
BACKEND_TAG=server
